#!/usr/bin/env bash
#
# dotfiles — bootstrap shim for the TypeScript CLI.
#
# This is the ONLY bash that survives the rewrite, and it exists to solve one
# problem: the CLI's job is to set up a bare Mac, but its own runtime is a
# package it installs. `brew "oven-sh/bun/bun"` is packages/bundle:150, which
# lands at step 3 of `dotfiles init` — so on a fresh machine bun does not exist
# when this file is first executed.
#
# Keep this bash 3.2 compatible. macOS ships bash 3.2.57 and steps 1-3 of a
# fresh `init` run under it, before Homebrew's bash exists. That means: no
# associative arrays, no `${var^^}`, no `mapfile`, and mind empty-array
# expansion under `set -u`.

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ─── Egg #1: the runtime ────────────────────────────────────────────
# Prefer Homebrew's bun so we converge on the same copy packages/bundle
# tracks. The curl installer is the bare-machine fallback; once brew exists a
# later `init` supersedes it (conf.d/paths.fish already ranks ~/.bun/bin below
# /opt/homebrew/bin, so there is no ambiguity about which one wins).
if ! command -v bun >/dev/null 2>&1; then
    if command -v brew >/dev/null 2>&1; then
        echo "bun not found — installing via Homebrew..." >&2
        brew install oven-sh/bun/bun
    else
        echo "bun not found and no Homebrew yet — bootstrapping bun directly..." >&2
        curl -fsSL https://bun.sh/install | bash
        export PATH="$HOME/.bun/bin:$PATH"
    fi
fi

# ─── Egg #2: dependencies ───────────────────────────────────────────
# A fresh clone has no node_modules. Any command needing them also needs the
# network, so installing here costs nothing we weren't already paying.
if [[ ! -d "$DIR/node_modules" ]]; then
    echo "installing dotfiles CLI dependencies..." >&2
    (cd "$DIR" && bun install --frozen-lockfile)
fi

exec bun "$DIR/src/cli.ts" "$@"
