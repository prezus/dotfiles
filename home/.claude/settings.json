{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^zed$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/zed.sh\"; exit 2"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark"
}
