{
  "lastChangelogVersion": "0.84.2",
  "theme": "catppuccin-macchiato",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "quietStartup": false,
  "npmCommand": [
    "bun"
  ],
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "defaultThinking": "low",
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "openai-codex/gpt-5.6-luna",
        "openai-codex/gpt-6-astra"
      ]
    },
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low",
        "timeoutMs": 600000,
        "turnBudget": {
          "maxTurns": 8,
          "graceTurns": 1
        }
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "medium",
        "timeoutMs": 600000,
        "turnBudget": {
          "maxTurns": 8,
          "graceTurns": 1
        }
      },
      "reviewer": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "medium"
      },
      "worker": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "medium"
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high"
      }
    }
  },
  "packages": [
    "npm:@plannotator/pi-extension@0.27.6",
    "npm:pi-stop@1.3.0",
    "npm:pi-toggle-skills@0.1.11",
    "npm:@ff-labs/pi-fff@0.10.5",
    "npm:@juicesharp/rpiv-ask-user-question@2.6.4",
    "npm:pi-subagents@0.53.0",
    "npm:pi-web-access@0.24.0"
  ]
}